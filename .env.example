# ---------------------------------------------------------------------------
# Supabase — required
# ---------------------------------------------------------------------------
# Local dev (after `pnpm db:start`) these are printed by the Supabase CLI.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin bootstrap — the profile with this email is promoted to role='admin'
# by supabase/seed.sql. See README "Manual steps".
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@hackathonlar.uz

# ---------------------------------------------------------------------------
# Google OAuth — created by a human in Google Cloud Console, then pasted into
# the Supabase dashboard (Authentication -> Providers -> Google).
# Kept here so `supabase/config.toml` can wire the local stack too.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
