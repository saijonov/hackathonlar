{
  "name": "hackathonlar-uz",
  "version": "1.0.0",
  "private": true,
  "description": "Hackathonlar.uz — hackathon review and discovery platform for Uzbekistan",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "seed:generate": "node scripts/generate-seed.mjs",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@vercel/analytics": "2.0.1",
    "clsx": "2.1.1",
    "lucide-react": "1.34.0",
    "next": "15.5.23",
    "next-intl": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@formatjs/icu-messageformat-parser": "3.5.17",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.23",
    "fontkit": "^2.0.4",
    "intl-messageformat": "11.2.14",
    "jsdom": "30.0.1",
    "lighthouse": "^13.4.1",
    "supabase": "^2.115.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "sharp",
      "unrs-resolver",
      "@parcel/watcher",
      "esbuild"
    ]
  }
}
